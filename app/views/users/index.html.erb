
<h1>Users</h1>
<%= link_to 'New User', new_user_path %>

<ul>
  <% @users.each do |user| %>
    <li>
      <%= link_to user.name, user_path(user) %> |
      <%= link_to 'Edit', edit_user_path(user) %> |
      
      <!-- Delete form (replacing the link with a form) -->
      <%= form_with(model: user, url: user_path(user), method: :delete, data: { confirm: 'Are you sure?' }) do |form| %>
        <%= form.submit 'Delete' %>
      <% end %>
    </li>
  <% end %>
</ul>

